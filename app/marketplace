"use client";
import { useState } from "react";
import Link from "next/link";
import "../home.css";

type Item = { id: number; type: "voice" | "dataset" | "api"; title: string; desc: string; lang: string; tribe: string; price: string; icon: string; };

export default function Marketplace() {
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState("All");
  const [copied, setCopied] = useState(false);
  const apiKey = "mnpp_live_sk_9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7";

  const items: Item[] = [
    { id: 1, type: "voice", title: "Lagos Pidgin Voices", desc: "1,200+ authentic Lagos street recordings", lang: "Pidgin", tribe: "Yoruba", price: "Free", icon: "🎙️" },
    { id: 2, type: "voice", title: "Warri Pidgin Raw", desc: "Deep Warri pidgin — Fast & rugged", lang: "Pidgin", tribe: "Urhobo", price: "Free", icon: "🔥" },
    { id: 3, type: "dataset", title: "Pidgin to English Dataset", desc: "50k parallel sentences — Train your AI", lang: "English/Pidgin", tribe: "All", price: "Free", icon: "📦" },
    { id: 4, type: "dataset", title: "Igbo Pidgin Mix", desc: "Igbo people speaking pidgin — Unique accent", lang: "Pidgin", tribe: "Igbo", price: "Free", icon: "📚" },
    { id: 5, type: "api", title: "Translate API", desc: "POST /api/translate — Pidgin → English", lang: "API", tribe: "All", price: "Pro", icon: "🔌" },
    { id: 6, type: "api", title: "Voices API", desc: "GET /api/voices — Stream voices", lang: "API", tribe: "All", price: "Free", icon: "🎧" },
    { id: 7, type: "voice", title: "Port Harcourt Pidgin", desc: "PH boys pidgin — Original", lang: "Pidgin", tribe: "Ikwerre", price: "Free", icon: "🎤" },
    { id: 8, type: "dataset", title: "Hausa Pidgin Collection", desc: "Northern pidgin with Hausa flavor", lang: "Pidgin", tribe: "Hausa", price: "Free", icon: "🗣️" },
  ];

  const filtered = items.filter(i => {
    const matchSearch = (i.title + i.desc + i.tribe + i.lang).toLowerCase().includes(search.toLowerCase());
    const matchFilter = filter === "All" || i.type === filter.toLowerCase() || i.tribe === filter;
    return matchSearch && matchFilter;
  });

  return (
    <div style={{minHeight:"100vh", background:"#080a08", padding:"16px"}}>
      <div style={{maxWidth:"700px", margin:"0 auto"}}>
        
        {/* TOP */}
        <div style={{display:"flex", alignItems:"center", gap:"10px", marginBottom:"16px"}}>
          <Link href="/" style={{color:"#4ade80", textDecoration:"none", fontSize:"14px", fontWeight:"700"}}>← Home</Link>
          <span style={{marginLeft:"auto", marginRight:"auto", color:"#555", fontSize:"12px", fontWeight:"800", letterSpacing:"2px"}}>API MARKETPLACE</span>
          <span style={{fontSize:"10px", background:"#102216", color:"#4ade80", padding:"4px 10px", borderRadius:"20px", border:"1px solid #1f5a2a"}}>● LIVE</span>
        </div>

        {/* SEARCH BAR - THE OLD ONE YOU WANT */}
        <div style={{background:"#111a12", border:"1px solid #1f3a25", borderRadius:"16px", padding:"12px", display:"flex", gap:"8px"}}>
          <div style={{flex:1, background:"black", border:"1px solid #1a2a1e", borderRadius:"12px", padding:"10px 14px", display:"flex", alignItems:"center", gap:"8px"}}>
            <span>🔍</span>
            <input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Search voices, datasets, APIs, tribes..." 
              style={{flex:1, background:"transparent", border:"none", outline:"none", color:"white", fontSize:"13px"}} />
          </div>
          <button onClick={()=>{navigator.clipboard.writeText(apiKey); setCopied(true); setTimeout(()=>setCopied(false),2000)}} 
            style={{background: copied ? "#22c55e" : "#1a2a1e", color: copied ? "black" : "white", border:"1px solid #2a3a2e", padding:"10px 14px", borderRadius:"12px", fontSize:"11px", fontWeight:"800", cursor:"pointer"}}>
            {copied ? "✓" : "Key"}
          </button>
        </div>

        {/* FILTER CHIPS - DIFFERENT DIFFERENT THINGS */}
        <div style={{marginTop:"14px", display:"flex", gap:"8px", overflowX:"auto", paddingBottom:"4px"}}>
          {["All","voice","dataset","api","Yoruba","Igbo","Hausa","Urhobo"].map(c=>(
            <button key={c} onClick={()=>setFilter(c)} 
              style={{whiteSpace:"nowrap", padding:"8px 14px", borderRadius:"20px", fontSize:"11px", fontWeight:"800", cursor:"pointer",
                background: filter===c ? "#22c55e" : "#1a1a1a", color: filter===c ? "black" : "#aaa", border: filter===c ? "1px solid #22c55e" : "1px solid #2a2a2a"}}>
              {c.toUpperCase()}
            </button>
          ))}
        </div>

        {/* RESULTS COUNT */}
        <div style={{marginTop:"14px", fontSize:"12px", color:"#666"}}>Showing <span style={{color:"white", fontWeight:"800"}}>{filtered.length}</span> results {search && `for "${search}"`}</div>

        {/* DIFFERENT DIFFERENT ITEMS - GRID */}
        <div style={{marginTop:"12px", display:"grid", gridTemplateColumns:"1fr 1fr", gap:"10px"}}>
          {filtered.map(item=>(
            <div key={item.id} style={{background:"#0f1210", border:"1px solid #1f2320", borderRadius:"16px", padding:"14px"}}>
              <div style={{display:"flex", justifyContent:"space-between"}}>
                <div style={{width:"36px", height:"36px", background:"#1a1a1a", borderRadius:"10px", display:"flex", alignItems:"center", justifyContent:"center", fontSize:"18px"}}>{item.icon}</div>
                <span style={{fontSize:"9px", padding:"4px 8px", borderRadius:"20px", fontWeight:"800", background: item.price==="Free" ? "#102216" : "#1f1a00", color: item.price==="Free" ? "#4ade80" : "#facc15", border:"1px solid #2a2a2a"}}>{item.price}</span>
              </div>
              <h3 style={{fontSize:"13px", fontWeight:"800", color:"white", margin:"10px 0 0 0"}}>{item.title}</h3>
              <p style={{fontSize:"11px", color:"#666", margin:"4px 0 0 0", lineHeight:"1.3"}}>{item.desc}</p>
              <div style={{marginTop:"10px", display:"flex", gap:"6px"}}>
                <span style={{fontSize:"8px", background:"black", border:"1px solid #222", padding:"3px 7px", borderRadius:"20px", color:"#777"}}>{item.type}</span>
                <span style={{fontSize:"8px", background:"black", border:"1px solid #222", padding:"3px 7px", borderRadius:"20px", color:"#777"}}>{item.tribe}</span>
              </div>
              <button style={{width:"100%", marginTop:"10px", background:"#1a1a1a", border:"1px solid #2a2a2a", color:"white", padding:"8px", borderRadius:"8px", fontSize:"11px", fontWeight:"700", cursor:"pointer"}}>Enter →</button>
            </div>
          ))}
        </div>

        {/* ENDPOINTS */}
        <div style={{marginTop:"14px", background:"#0f1210", border:"1px solid #1f2320", borderRadius:"16px", padding:"14px"}}>
          <h3 style={{fontSize:"12px", fontWeight:"800", color:"white", margin:0}}>Quick Endpoints</h3>
          <div style={{marginTop:"10px", display:"flex", gap:"8px", flexWrap:"wrap"}}>
            <code style={{background:"black", padding:"6px 10px", borderRadius:"6px", fontSize:"10px", color:"#4ade80"}}>GET /api/voices</code>
            <code style={{background:"black", padding:"6px 10px", borderRadius:"6px", fontSize:"10px", color:"#4ade80"}}>GET /api/datasets</code>
            <code style={{background:"black", padding:"6px 10px", borderRadius:"6px", fontSize:"10px", color:"#c4b5fd"}}>POST /api/translate</code>
          </div>
        </div>

        <div style={{marginTop:"16px", textAlign:"center", fontSize:"10px", color:"#333"}}>MAIN NAIJA PIDGIN © 2026 — Searchable Marketplace ✅</div>
      </div>
    </div>
  );
}