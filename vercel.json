{
  "rewrites": [
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/user",
      "destination": "/index.html"
    },
    {
      "source": "/user/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/chairman",
      "destination": "/index.html"
    },
    {
      "source": "/chairman/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/chairman/login",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true
}